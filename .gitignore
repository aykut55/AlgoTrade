## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
launchSettings.json

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# User-specific files
*.rsuser
*.DotSettings.user

# Claude Code
.claude/

# Windows
Thumbs.db
desktop.ini

# Python venv
**/.venv/

# Python cache
**/__pycache__/

# MkDocs build output (docs/ kaynak, bundan uretilir - bkz. mkdocs.yml)
/site/

# DearPyGuiDataPlotter / DearImGuiBundleDataPlotter alt-projeleri
src/DearImGuiBundleDataPlotter/*.ini
# latest_bundle.npz / latest_bundle.view.json artik ignore'da (2026-09-01, kullanici karari) -
# her plotter kosusunda uzerine yazilan ~20MB'lik calisma ciktisi, git history'yi sisiriyordu.
# Onceden "standalone demo verisi gelsin" diye commitliydi; standalone demo gerekiyorsa sabit
# isimli ayri bir sample bundle commit'lenir. full_pipeline_bundle.* / IPC kuyrugu zaten runtime verisi.
src/DearPyGuiDataPlotter/inputs/full_pipeline_bundle.npz
src/DearPyGuiDataPlotter/inputs/full_pipeline_bundle.view.json
src/DearPyGuiDataPlotter/inputs/runtime_commands/
src/DearPyGuiDataPlotter/inputs/latest_bundle.npz
src/DearPyGuiDataPlotter/inputs/latest_bundle.view.json
inputs/python/dearPyGuiDataPlotter/latest_bundle.npz
inputs/python/dearPyGuiDataPlotter/latest_bundle.view.json
inputs/python/pythonPlotter/latest_bundle.npz
inputs/python/pythonPlotter/latest_bundle.view.json

# Offline Replay: samples/ commit'lenmiyor (GenerateReplaySampleBundles.csx cikisi, buyuk,
# playlist.json'dan bagimsiz elle uretilen/kopyalanan ornek veri - kullanici karari,
# 2026-08-26). playlist.json/input.json/combined.npz/combined.view.json COMMITLI kaliyor.
inputs/python/offlineReplay/samples/